{
  "name": "haechi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:desktop": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev --workspace electron\"",
    "start:backend": "npm run start --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "start:desktop": "npm run start --workspace electron"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
